# Copy to .env and adjust. Nested groups use "__" (e.g. INGEST_KAFKA__BOOTSTRAP_SERVERS).
INGEST_INSTANCE_ID=local-0
INGEST_LOG_LEVEL=INFO
INGEST_METRICS_PORT=9100
INGEST_API_KEYS={"dev-key-tenant-1":"tenant_1","dev-key-tenant-2":"tenant_2","dev-key-tenant-3":"tenant_3","dev-key-tenant-4":"tenant_4","dev-key-tenant-5":"tenant_5"}
INGEST_KAFKA__BOOTSTRAP_SERVERS=localhost:9092
INGEST_KAFKA__PRODUCER_POOL_SIZE=4
INGEST_BATCHING__BATCH_MAX_RECORDS=500
INGEST_BATCHING__BATCH_MAX_BYTES=1048576
INGEST_BATCHING__BATCH_FLUSH_INTERVAL_MS=100
INGEST_RETRY__MAX_ATTEMPTS=5
INGEST_REDIS__URL=redis://localhost:6379/0
INGEST_GRPC__PORT=50051

# --- Managed Kafka (e.g. Aiven) over SASL_SSL. Leave commented for local docker-compose. ---
# INGEST_KAFKA__BOOTSTRAP_SERVERS=kafka-xxxx.c.aivencloud.com:28672
# INGEST_KAFKA__SECURITY_PROTOCOL=SASL_SSL
# INGEST_KAFKA__SASL_MECHANISM=SCRAM-SHA-256
# INGEST_KAFKA__SASL_USERNAME=avnadmin
# INGEST_KAFKA__SASL_PASSWORD=<paste from the console; never commit>
# INGEST_KAFKA__SSL_CAFILE=certs/ca.pem
# INGEST_KAFKA__TOPIC_REPLICATION_FACTOR=3
